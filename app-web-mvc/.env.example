# =====================================================================
# Variables de entorno de la APLICACIÓN WEB MVC
# ---------------------------------------------------------------------
# Copiar como ".env" en esta misma carpeta y completar los valores.
# El archivo ".env" NUNCA se sube a Git (está en .gitignore).
# =====================================================================

# Puerto de esta aplicación en local. La API de usuarios usa 3000.
PORT=3001

# Base de la ENTIDAD PRINCIPAL (productos). Distinta de usuarios_db.
# Local:  mongodb://127.0.0.1:27017/tp_negocio
# Atlas:  mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/tp_negocio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tp_negocio

# Clave con la que se firman las cookies de sesión. Usar una cadena larga y aleatoria.
SESSION_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# URL base de la API REST de usuarios (Proyecto 1).
# Local:  http://localhost:3000/api/usuarios
# Render: https://tu-api-usuarios.onrender.com/api/usuarios
API_USUARIOS_URL=http://localhost:3000/api/usuarios

# development muestra el detalle técnico de los errores; production activa cookies seguras.
NODE_ENV=development
