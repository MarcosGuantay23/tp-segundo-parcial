<%- include('../partials/header', { titulo: titulo }) %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-4"><%= titulo %></h1>

        <!-- Errores devueltos por la API (validación o email duplicado) -->
        <% if (errores.length) { %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% errores.forEach(function(e) { %><li><%= e %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <form action="<%= accion %>" method="POST" class="needs-validation" novalidate>
          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="nombre" class="form-label">Nombre y apellido</label>
              <input type="text" class="form-control" id="nombre" name="nombre"
                     value="<%= datos.nombre || '' %>" required minlength="2" maxlength="100">
              <div class="invalid-feedback">Entre 2 y 100 caracteres.</div>
            </div>

            <div class="col-12 col-md-6">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email"
                     value="<%= datos.email || '' %>" required maxlength="100">
              <div class="invalid-feedback">Ingresá un email válido.</div>
            </div>

            <div class="col-12 col-md-6">
              <label for="password" class="form-label">
                Contraseña
                <% if (!esNuevo) { %><span class="text-muted small">(dejar vacía para no cambiarla)</span><% } %>
              </label>
              <input type="password" class="form-control" id="password" name="password"
                     <%= esNuevo ? 'required' : '' %> minlength="6">
              <div class="invalid-feedback">Mínimo 6 caracteres.</div>
            </div>

            <div class="col-12 col-md-6">
              <label for="perfil" class="form-label">Perfil</label>
              <select class="form-select" id="perfil" name="perfil" required>
                <option value="">Seleccionar...</option>
                <% perfiles.forEach(function(p) { %>
                  <option value="<%= p %>" <%= datos.perfil === p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
              <div class="invalid-feedback">Seleccioná un perfil.</div>
            </div>

            <div class="col-12">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="activo" name="activo"
                       <%= datos.activo ? 'checked' : '' %>>
                <label class="form-check-label" for="activo">Usuario habilitado</label>
              </div>
            </div>
          </div>

          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="/usuarios" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
