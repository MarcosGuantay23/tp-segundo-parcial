<%- include('../partials/header', { titulo: titulo }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h1 class="h3 mb-0">Usuarios</h1>
    <p class="text-muted mb-0 small">Datos obtenidos desde la API REST de usuarios</p>
  </div>
  <a href="/usuarios/nuevo" class="btn btn-primary">+ Nuevo usuario</a>
</div>

<!-- Filtros enviados por GET: la URL queda con los criterios aplicados -->
<form method="GET" action="/usuarios" class="card card-body border-0 shadow-sm mb-3">
  <div class="row g-2 align-items-end">
    <div class="col-12 col-md-5">
      <label for="q" class="form-label small mb-1">Buscar por nombre o email</label>
      <input type="text" class="form-control" id="q" name="q" value="<%= filtros.q %>" maxlength="100">
    </div>
    <div class="col-6 col-md-3">
      <label for="perfil" class="form-label small mb-1">Perfil</label>
      <select class="form-select" id="perfil" name="perfil">
        <option value="">Todos</option>
        <% perfiles.forEach(function(p) { %>
          <option value="<%= p %>" <%= filtros.perfil === p ? 'selected' : '' %>><%= p %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <label for="activo" class="form-label small mb-1">Estado</label>
      <select class="form-select" id="activo" name="activo">
        <option value="">Todos</option>
        <option value="true"  <%= filtros.activo === 'true'  ? 'selected' : '' %>>Habilitados</option>
        <option value="false" <%= filtros.activo === 'false' ? 'selected' : '' %>>Deshabilitados</option>
      </select>
    </div>
    <div class="col-12 col-md-2 d-grid">
      <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </div>
  </div>
</form>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Nombre</th>
          <th>Email</th>
          <th>Perfil</th>
          <th>Estado</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (usuarios.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No se encontraron usuarios.</td></tr>
        <% } %>
        <% usuarios.forEach(function(u) { %>
          <tr class="<%= u.activo ? '' : 'table-secondary text-muted' %>">
            <td><%= u.nombre %></td>
            <td><%= u.email %></td>
            <td>
              <span class="badge <%= u.perfil === 'Administrador' ? 'bg-danger' : 'bg-info text-dark' %>"><%= u.perfil %></span>
            </td>
            <td>
              <% if (u.activo) { %>
                <span class="badge bg-success">Habilitado</span>
              <% } else { %>
                <span class="badge bg-secondary">Deshabilitado</span>
              <% } %>
            </td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-primary" href="/usuarios/<%= u._id %>/editar">Modificar</a>
              <% if (u.activo) { %>
                <!-- Baja lógica: POST con confirmación previa (data-confirm lo maneja validar-formularios.js) -->
                <form action="/usuarios/<%= u._id %>/eliminar" method="POST" class="d-inline" data-confirm="¿Deshabilitar a <%= u.nombre %>?">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Deshabilitar</button>
                </form>
              <% } else { %>
                <form action="/usuarios/<%= u._id %>/habilitar" method="POST" class="d-inline">
                  <button class="btn btn-sm btn-outline-success" type="submit">Habilitar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-white small text-muted">Total: <%= total %> usuario(s)</div>
</div>

<%- include('../partials/footer') %>
