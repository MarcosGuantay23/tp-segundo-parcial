<%- include('../partials/header', { titulo: titulo }) %>

<div class="row justify-content-center">
  <div class="col-12 col-lg-9">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-4"><%= titulo %></h1>

        <% if (errores.length) { %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% errores.forEach(function(e) { %><li><%= e %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <!-- enctype multipart/form-data es OBLIGATORIO para enviar archivos -->
        <form action="<%= accion %>" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate
              data-max-bytes="2097152" data-formatos="<%= formatos %>">
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <label for="codigo" class="form-label">Código</label>
              <input type="text" class="form-control text-uppercase" id="codigo" name="codigo"
                     value="<%= producto.codigo || '' %>" required minlength="3" maxlength="20">
              <div class="invalid-feedback">Entre 3 y 20 caracteres.</div>
            </div>

            <div class="col-12 col-md-4">
              <label for="marca" class="form-label">Marca</label>
              <input type="text" class="form-control" id="marca" name="marca"
                     value="<%= producto.marca || '' %>" required maxlength="50">
              <div class="invalid-feedback">La marca es obligatoria.</div>
            </div>

            <div class="col-12 col-md-4">
              <label for="modelo" class="form-label">Modelo</label>
              <input type="text" class="form-control" id="modelo" name="modelo"
                     value="<%= producto.modelo || '' %>" required maxlength="80">
              <div class="invalid-feedback">El modelo es obligatorio.</div>
            </div>

            <div class="col-12 col-md-4">
              <label for="categoria" class="form-label">Categoría</label>
              <select class="form-select" id="categoria" name="categoria" required>
                <option value="">Seleccionar...</option>
                <% categorias.forEach(function(c) { %>
                  <option value="<%= c %>" <%= producto.categoria === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
              <div class="invalid-feedback">Seleccioná una categoría.</div>
            </div>

            <div class="col-12 col-md-4">
              <label for="precio" class="form-label">Precio ($)</label>
              <input type="number" class="form-control" id="precio" name="precio"
                     value="<%= producto.precio %>" required min="0" step="0.01">
              <div class="invalid-feedback">Ingresá un precio válido (0 o mayor).</div>
            </div>

            <div class="col-12">
              <label for="descripcion" class="form-label">Descripción</label>
              <textarea class="form-control" id="descripcion" name="descripcion" rows="3" maxlength="500"><%= producto.descripcion || '' %></textarea>
            </div>

            <div class="col-12 col-md-6">
              <label for="fotografia" class="form-label">
                Fotografía
                <% if (esNuevo) { %><span class="text-danger">*</span><% } %>
              </label>
              <input type="file" class="form-control" id="fotografia" name="fotografia"
                     accept="image/jpeg,image/png,image/webp" <%= esNuevo ? 'required' : '' %>>
              <div class="form-text">JPG, PNG o WEBP. Máximo 2 MB.</div>
              <div class="invalid-feedback" id="error-fotografia">Seleccioná una imagen válida.</div>
            </div>

            <div class="col-12 col-md-6 d-flex align-items-center">
              <!-- Vista previa de la foto actual (si existe) -->
              <img src="<%= producto.fotografia || '/images/sin-foto.svg' %>" alt="Foto actual"
                   class="foto-form rounded border" id="vista-previa">
            </div>
          </div>

          <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="/productos" class="btn btn-outline-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
