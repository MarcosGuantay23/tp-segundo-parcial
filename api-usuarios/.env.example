# =====================================================================
# Variables de entorno de la API REST de Usuarios
# ---------------------------------------------------------------------
# Copiar este archivo como ".env" (en la misma carpeta) y completar
# los valores reales. El archivo ".env" NUNCA se sube a Git
# (está listado en .gitignore).
# =====================================================================

# Puerto en el que escucha Express en local.
# En Render no hace falta definirlo: la plataforma inyecta PORT automáticamente.
PORT=3000

# Cadena de conexión a MongoDB (local o MongoDB Atlas).
# Base de datos EXCLUSIVA de usuarios, distinta de la base de la app MVC.
# Ejemplo local:  mongodb://127.0.0.1:27017/usuarios_db
# Ejemplo Atlas:  mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/usuarios_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/usuarios_db

# Cantidad de "rondas" (costo computacional) que usa bcrypt para generar el hash.
# Valores típicos: 10 a 12. Cuanto mayor, más segundo hash y más seguro.
BCRYPT_SALT_ROUNDS=10
